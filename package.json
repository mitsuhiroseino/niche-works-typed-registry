{
  "name": "@niche-works/typed-registry",
  "version": "0.1.3",
  "private": true,
  "keywords": [
    "registry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mitsuhiroseino/niche-works-typed-registry.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts",
    "./GlobalRegistry": "./src/GlobalRegistry/index.ts",
    "./types": "./src/types.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "test": "vitest",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.js"
  },
  "dependencies": {
    "klona": "^2.0.6",
    "tslib": "^2.8.1",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "@niche-works/dev": "^0.5.4",
    "@niche-works/rollup-plugin-dist-package": "^0.2.2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.5",
    "fast-glob": "^3.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-copy": "^3.5.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.32.1"
}
